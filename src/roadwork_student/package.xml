<?xml version="1.0"?>
<package format="3">
  <name>roadwork_student</name>
  <version>0.3.0</version>
  <description>IASYS Roadwork Challenge student solution: sense_node, plan_node and act_node (C++17, ROS2 Jazzy)</description>
  <maintainer email="ritabarbosa26.rb@gmail.com">IASYS student group</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>roadwork_interfaces</depend>
  <depend>roadwork_student_interfaces</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>roadwork_sim</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <test_depend>ament_cmake_test</test_depend>
  <!-- Test-only: the supplied simulator core is used as a plant in the offline closed-loop test. -->
  <test_depend>roadwork_core</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
